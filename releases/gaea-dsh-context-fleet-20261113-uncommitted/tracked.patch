+  opacity: 0;
+  pointer-events: none;
+  transform: translateY(-50%);
+  background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--bg-elev) 86%, transparent) 26%);
+  transition: opacity .15s ease;
+}
+.office-file-card:hover .office-file-card__actions,
+.office-file-card:focus-within .office-file-card__actions {
+  opacity: 1;
+  pointer-events: auto;
+}
+.office-file-card__actions button {
+  width: 22px;
+  height: 22px;
+}
+.office-file-card[data-missing="true"] .office-file-card__badge {
+  filter: grayscale(1);
+}
+
+/* ── 8. 输入框上方交付停靠条：与正文成果卡共用同一视觉语言 ─────────── */
+.office-delivery-dock {
+  width: min(880px, 100%);
+  margin: 0 auto 8px;
+  container-type: inline-size;
+}
+.office-delivery-dock__head {
+  display: inline-flex;
+  width: fit-content;
+  max-width: 100%;
+  min-height: 28px;
+  align-items: center;
+  gap: 6px;
+  padding: 3px 8px;
+  border: 0;
+  border-radius: 8px;
+  color: var(--lx-text2);
+  background: transparent;
+  cursor: pointer;
+}
+.office-delivery-dock__head:hover { background: var(--lx-fill); }
+.office-delivery-dock__head:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 1px;
+}
+.office-delivery-dock__chevron {
+  flex: none;
+  color: var(--lx-text3);
+  transition: transform var(--dur-base) var(--ease-out);
+}
+.office-delivery-dock__chevron[data-open="true"] { transform: rotate(90deg); }
+.office-delivery-dock__title {
+  color: var(--lx-text2);
+  font-size: 12.5px;
+  font-weight: 500;
+  white-space: nowrap;
+}
+.office-delivery-dock__count {
+  min-width: 16px;
+  padding: 0 5px;
+  border-radius: 999px;
+  color: var(--lx-text3);
+  background: var(--lx-fill);
+  font-family: var(--font-mono, var(--mono));
+  font-size: 9px;
+  line-height: 16px;
+  text-align: center;
+}
+.office-delivery-dock__hint {
+  color: color-mix(in srgb, var(--fg) 34%, transparent);
+  font-size: 10px;
+  white-space: nowrap;
+}
+.office-delivery-dock__body { margin-top: 4px; }
+.office-delivery-dock__grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 6px;
+}
+.office-file-card--compact {
+  height: 44px;
+  border-radius: 10px;
+}
+.office-file-card--compact .office-file-card__open {
+  gap: 9px;
+  padding: 8px 48px 8px 12px;
+}
+.office-file-card--compact .office-file-card__badge {
+  width: 20px;
+  height: 20px;
+  border-radius: 4px;
+  font-size: 6.5px;
+}
+.office-file-card--compact .office-file-card__copy { gap: 0; }
+.office-file-card--compact .office-file-card__name {
+  font-size: 12.5px;
+  line-height: 18px;
+}
+.office-file-card--compact .office-file-card__meta {
+  position: absolute;
+  top: 50%;
+  right: 8px;
+  transform: translateY(-50%);
+}
+.office-file-card--compact:hover .office-file-card__meta,
+.office-file-card--compact:focus-within .office-file-card__meta {
+  opacity: 0;
+}
+.office-file-card--compact .office-file-card__actions { right: 5px; }
+.office-delivery-dock__more {
+  display: block;
+  margin: 6px auto 0;
+  padding: 3px 8px;
+  border: 0;
+  border-radius: 6px;
+  color: var(--lx-text3);
+  background: transparent;
+  font-size: 10.5px;
+  cursor: pointer;
+}
+.office-delivery-dock__more:hover {
+  color: var(--fg);
+  background: var(--lx-fill);
+}
+
+/* ── 9. 右侧会话产物面板：沿用成果卡类型色与紧凑操作位 ─────────────── */
+.office-file-card--panel {
+  display: flex;
+  width: 100%;
+  min-height: 54px;
+  height: auto;
+  align-items: center;
+  border-radius: 10px;
+}
+.office-file-card--panel > .office-file-card__badge {
+  margin-left: 12px;
+}
+.office-deliverable-panel__thumb {
+  display: inline-flex;
+  width: 24px;
+  height: 24px;
+  flex: none;
+  align-items: center;
+  justify-content: center;
+  margin-left: 12px;
+  overflow: hidden;
+  border-radius: 4px;
+}
+.office-deliverable-panel__open {
+  display: flex;
+  min-width: 0;
+  flex: 1 1 auto;
+  flex-direction: column;
+  gap: 1px;
+  padding: 7px 4px 7px 10px;
+  border: 0;
+  color: var(--fg);
+  background: transparent;
+  text-align: left;
+  cursor: pointer;
+}
+.office-deliverable-panel__open:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: -2px;
+  border-radius: 8px;
+}
+.office-deliverable-panel__title-row {
+  display: flex;
+  min-width: 0;
+  align-items: center;
+  gap: 4px;
+}
+.office-file-card--panel .office-file-card__name {
+  min-width: 0;
+  font-size: 12.5px;
+  font-weight: 550;
+  line-height: 18px;
+}
+.office-deliverable-panel__path {
+  display: block;
+  min-width: 0;
+  overflow: hidden;
+  color: var(--lx-text3);
+  font-family: var(--font-mono, var(--mono));
+  font-size: 9px;
+  line-height: 13px;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  opacity: 0;
+  transition: opacity var(--dur-fast) ease;
+}
+.office-file-card--panel:hover .office-deliverable-panel__path,
+.office-file-card--panel:focus-within .office-deliverable-panel__path {
+  opacity: 1;
+}
+.office-file-card--panel .office-deliverable-panel__version {
+  margin-right: 5px;
+}
+.office-deliverable-panel__actions {
+  position: absolute;
+  z-index: 2;
+  top: 50%;
+  right: 5px;
+  max-width: calc(100% - 42px);
+  overflow: hidden;
+  padding-left: 24px;
+  transform: translateY(-50%);
+  background: linear-gradient(90deg, transparent, var(--office-panel) 24%);
+}
+.office-deliverable-panel__actions button {
+  width: 20px;
+  height: 20px;
+}
+.office-file-card--panel[data-fresh="true"] {
+  border-color: color-mix(in srgb, var(--accent) 28%, var(--lx-line));
+  box-shadow: inset 2px 0 0 color-mix(in srgb, var(--accent) 72%, transparent);
+}
+
+@media (max-width: 680px) {
+  .office-deliverables__grid { grid-template-columns: minmax(0, 1fr); }
+  .office-delivery-dock__grid { grid-template-columns: minmax(0, 1fr); }
+  .office-delivery-dock__hint { display: none; }
+}
+@container (max-width: 520px) {
+  .office-deliverables__grid { grid-template-columns: minmax(0, 1fr); }
+  .office-delivery-dock__grid { grid-template-columns: minmax(0, 1fr); }
+}
+@media (prefers-reduced-motion: reduce) {
+  .office-file-card,
+  .office-file-card__actions { transition: none; }
+  .office-file-card:active { transform: none; }
+}
