# dist/ 是 wails 构建产物（main.go go:embed all:dist），只保留 .gitkeep 占位——
# fresh checkout / go build ./... 需要 dist 目录存在（2026-09-27 审计 P0-1）。
dist/*
!dist/.gitkeep

